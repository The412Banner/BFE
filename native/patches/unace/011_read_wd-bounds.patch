Description: Reject an out-of-range tree size in read_wd()
 uplim is read as 4 bits (0..15) from the archive, but wd_svwd[] only has
 svwd_cnt (15) entries, so a corrupt or crafted archive wrote one byte past the
 array. Treat it as a broken archive instead (found with AddressSanitizer).
Author: The412Banner
Forwarded: no

--- a/uac_dcpr.c
+++ b/uac_dcpr.c
@@ -362,6 +362,8 @@
    addbits(4);
    uplim = code_rd >> (32 - 4);
    addbits(4);
+   if (uplim >= svwd_cnt)               // wd_svwd[] holds svwd_cnt entries
+      return (0);
 
    for (i = -1; ++i <= uplim;)
    {
