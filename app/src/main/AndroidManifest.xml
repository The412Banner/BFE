        </activity>

        <!-- Built-in document viewer (PDF, OpenDocument, Office Open XML, RTF, Markdown, EPUB, CSV / TSV,
             plain text). Also offered to other apps as "BFE Documents". Older binary .doc / .xls / .ppt are
             recognised inside BFE but not claimed here: the viewer can only explain them. -->
        <activity
            android:name="com.the412banner.bfe.DocumentViewerActivity"
            android:label="@string/documents_label"
            android:theme="@style/AppTheme"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation|uiMode">
