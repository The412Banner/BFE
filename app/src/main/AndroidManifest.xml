<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- All-Files-Access is required: the bundled native extractors write directly to the
         filesystem and cannot write through SAF. READ/WRITE_EXTERNAL_STORAGE cover pre-R. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- The extraction foreground service keeps a long job alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held while extracting so screen-off CPU suspend doesn't pause a multi-hour repack. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the user exempt the app from battery optimisation for long background extractions. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets "Open with" hand off an extracted installer/APK to the package installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        tools:ignore="DataExtractionRules">

        <activity
            android:name="com.the412banner.bfe.MainActivity"
            android:theme="@style/AppTheme"
            android:screenOrientation="sensor"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.the412banner.bfe.UnpackArchiveActivity"
            android:theme="@style/AppTheme"
            android:screenOrientation="sensor"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|navigation">
            <!-- Let the OS "Open with"/Share sheet hand an archive or a GOG setup.exe to the extractor. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name="com.the412banner.bfe.unpack.UnpackService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Archive creation (Compress…): the extraction service's sibling, same lifecycle. -->
        <service
            android:name="com.the412banner.bfe.pack.PackService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- APK clone / edit / sign pipeline (ARSCLib rewrite + apksig), same lifecycle. -->
        <service
            android:name="com.the412banner.bfe.apk.ApkJobService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- FileProvider for "Open with" content:// hand-off of files inside the file manager. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
