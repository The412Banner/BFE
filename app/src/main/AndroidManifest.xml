        <service
            android:name="com.the412banner.bfe.pack.PackService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- APK clone / edit / sign pipeline (ARSCLib rewrite + apksig), same lifecycle. -->
        <service
            android:name="com.the412banner.bfe.apk.ApkJobService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Video conversion (bundled ffmpeg), same lifecycle. -->
        <service
            android:name="com.the412banner.bfe.video.ConvertService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- "Access from network": the local Wi-Fi HTTP / FTP file server, same lifecycle shape. -->
        <service
            android:name="com.the412banner.bfe.server.ServerService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Cloud / Remote uploads and downloads (rclone), same lifecycle as the jobs above. -->
        <service
            android:name="com.the412banner.bfe.cloud.CloudTransferService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

