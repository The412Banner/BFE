<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- All-Files-Access is required: the bundled native extractors write directly to the
         filesystem and cannot write through SAF. READ/WRITE_EXTERNAL_STORAGE cover pre-R. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- The extraction foreground service keeps a long job alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Held while extracting so screen-off CPU suspend doesn't pause a multi-hour repack. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Lets the user exempt the app from battery optimisation for long background extractions. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets "Open with" hand off an extracted installer/APK to the package installer, and lets the
         in-app updater install a new BFE release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The in-app updater: reads update.json and downloads the release APK from GitHub. Also lets
         "Access from network" open its listening sockets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Home → Apps: lists BFE under Settings → Usage access so the user can allow it; only then does
         StorageStatsManager report other apps' sizes. Nothing is granted by declaring it. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Home → Apps → Uninstall: apps targeting API 28+ need this (normal) permission to hand a package
         to the system uninstall dialog; the user still confirms every uninstall there. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- "Access from network": find the Wi-Fi / hotspot addresses to bind to (never mobile data) and
         hold a Wi-Fi lock while files are being shared. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- The Open with sheet lists every app that can VIEW a file. Not needed at targetSdk 28, but
         declared so the list keeps working if targetSdk is raised past 29 (package visibility). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

