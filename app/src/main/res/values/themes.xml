<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming (BfeTheme); this host theme just needs to be a valid,
         action-bar-less DayNight base for the activity window. AppCompat provides it without
         needing a newer Material Components release. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
