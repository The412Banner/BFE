<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP only to this device itself: Cloud / Remote drive BFE's own rclone engine through its
     remote-control API on 127.0.0.1 (random port + password). Every other host keeps Android's
     default for targetSdk 28+ (HTTPS only). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
